# ==============================================================================
# MONEY MANAGER WEBAPP - PLANTILLA GENERAL DE VARIABLES DE ENTORNO (MONOREPO)
# ==============================================================================
# Copia este archivo como .env (o .env.development / .env.staging / .env.production)
# NUNCA subas archivos .env con credenciales reales al repositorio Git.

# --- Perfil de Ejecucion ---
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# --- Base de Datos PostgreSQL / Supabase ---
# Desarrollo Local: jdbc:postgresql://localhost:5432/money_manager
# Supabase (Staging/Prod): jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_URL=jdbc:postgresql://localhost:5432/money_manager
DB_USERNAME=postgres
DB_PASSWORD=tu_password_postgresql

# --- Seguridad JWT y Cookies ---
# Clave secreta HMAC-SHA256 (minimo 256 bits / 64 caracteres hexadecimales)
JWT_SECRET=reemplazar_con_clave_hexadecimal_segura_de_al_menos_64_caracteres
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

# En desarrollo local (HTTP): COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# En Staging / Produccion (HTTPS cross-origin): COOKIE_SECURE=true, COOKIE_SAME_SITE=None (o Lax si comparten dominio raiz)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Configuracion CORS (Backend) ---
# Lista de origenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Servidor de Correo SMTP (Recuperacion de Contrasena OTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_de_16_letras

# --- Frontend (Vite) ---
# En desarrollo local usa el proxy de Vite (/api)
# En Staging / Produccion apunta a la URL publica del backend (ej. https://api-staging.moneymanager.com/api)
VITE_APP_ENV=development
VITE_API_URL=/api
