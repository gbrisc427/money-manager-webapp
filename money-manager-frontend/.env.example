# ==============================================================================
# MONEY MANAGER FRONTEND (REACT 19 + VITE 6) - PLANTILLA .env.example
# ==============================================================================
# Variables expuestas al cliente deben comenzar obligatoriamente con el prefijo VITE_

# Nombre del entorno actual (development | staging | production)
VITE_APP_ENV=development

# URL base del API Backend
# - En desarrollo local: /api (redirigido por el proxy de vite.config.ts a http://localhost:8081)
# - En preproduccion (staging): https://<tu-backend-staging-url>/api
# - En produccion (production): https://<tu-backend-prod-url>/api
VITE_API_URL=/api
