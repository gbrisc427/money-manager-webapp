# ==============================================================================
# MONEY MANAGER BACKEND (SPRING BOOT 3.5 / JAVA 21) - PLANTILLA .env.example
# ==============================================================================
# Copia este archivo como .env, .env.development, .env.staging o .env.production

# --- Perfil Activo y Puerto ---
# Valores soportados: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# --- Conexion JDBC PostgreSQL / Supabase ---
# Local: jdbc:postgresql://localhost:5432/money_manager
# Supabase Transaction Pooler (Puerto 6543): jdbc:postgresql://<host>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# Supabase Session Pooler (Puerto 5432): jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/money_manager
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_password_db

# --- Pool de Conexiones HikariCP ---
# Local: max=10, min=2 | Supabase (PgBouncer): max=5, min=1
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# --- Estrategia Hibernate DDL y Logs SQL ---
# dev: update | staging: update | prod: validate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Seguridad Criptografica JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_con_clave_hexadecimal_de_64_caracteres_minimo_256_bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

# --- Politica de Cookies HttpOnly ---
# dev: COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# staging/prod (HTTPS): COOKIE_SECURE=true, COOKIE_SAME_SITE=None (si frontend y backend estan en dominios distintos)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Servicio SMTP (JavaMailSender) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta_smtp@gmail.com
MAIL_PASSWORD=tu_app_password_smtp
